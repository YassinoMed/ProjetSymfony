{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aep.local/contracts/json-schemas/feature-definition.v1.json",
  "title": "FeatureDefinition",
  "type": "object",
  "required": ["slug", "name", "fields"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": {
            "enum": [
              "string",
              "text",
              "integer",
              "decimal",
              "boolean",
              "date",
              "datetime",
              "select"
            ]
          },
          "required": { "type": "boolean", "default": false },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
