<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Auto-Evolving Platform{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚡️</text></svg>">
        <style>
            :root {
                color-scheme: dark;
                --bg: #070d19;
                --panel: #0f1a2e;
                --panel-strong: #15233c;
                --border: #22344f;
                --text: #e6edf7;
                --muted: #8fa3c0;
                --accent: #5eead4;
                --accent-strong: #2dd4bf;
                --danger: #fb7185;
            }

            * { box-sizing: border-box; }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
                background:
                    radial-gradient(60rem 30rem at 85% -10%, rgba(45, 212, 191, .16), transparent 60%),
                    radial-gradient(50rem 28rem at -10% 10%, rgba(99, 102, 241, .14), transparent 55%),
                    var(--bg);
                color: var(--text);
                line-height: 1.55;
            }

            a { color: var(--accent); text-decoration: none; }
            a:hover { color: var(--accent-strong); }

            .topbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 1rem 2rem;
                border-bottom: 1px solid var(--border);
                background: rgba(7, 13, 25, .75);
                backdrop-filter: blur(10px);
                position: sticky;
                top: 0;
                z-index: 10;
            }

            .brand { color: var(--text); font-weight: 700; letter-spacing: -.02em; }
            .brand span { color: var(--accent); }

            .topbar-right { display: flex; align-items: center; gap: 1rem; }
            .topbar-right form { margin: 0; }
            .user { color: var(--muted); font-size: .9rem; }

            .badge {
                display: inline-flex;
                align-items: center;
                gap: .4rem;
                padding: .25rem .7rem;
                border: 1px solid rgba(94, 234, 212, .35);
                border-radius: 999px;
                background: rgba(94, 234, 212, .1);
                color: var(--accent);
                font-size: .8rem;
                font-weight: 600;
            }

            .container {
                width: min(72rem, 100% - 2.5rem);
                margin: 3rem auto;
            }

            .panel {
                background: linear-gradient(180deg, rgba(21, 35, 60, .65), rgba(15, 26, 46, .9));
                border: 1px solid var(--border);
                border-radius: 1rem;
                padding: 2rem;
                box-shadow: 0 20px 60px rgba(0, 0, 0, .35);
            }

            h1 { margin: 0 0 .35rem; font-size: clamp(1.6rem, 4vw, 2.2rem); letter-spacing: -.03em; }
            h2 { margin: 0 0 .5rem; font-size: 1.1rem; }
            p { margin: 0 0 1.25rem; }
            .muted { color: var(--muted); }

            .auth-card { max-width: 26rem; margin: 4rem auto; }

            label { display: block; margin: .9rem 0 .35rem; font-size: .85rem; color: var(--muted); }

            input[type="email"], input[type="password"], input[type="text"], select {
                width: 100%;
                padding: .8rem .9rem;
                border-radius: .6rem;
                border: 1px solid var(--border);
                background: rgba(7, 13, 25, .7);
                color: var(--text);
                font-size: 1rem;
                outline: none;
            }

            input:focus, select:focus { border-color: var(--accent-strong); box-shadow: 0 0 0 3px rgba(45, 212, 191, .15); }

            .btn, .btn-ghost {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: .5rem;
                border-radius: .6rem;
                font-weight: 600;
                font-size: .95rem;
                padding: .75rem 1.1rem;
                cursor: pointer;
                border: 1px solid transparent;
            }

            .btn {
                width: 100%;
                margin-top: 1.4rem;
                background: var(--accent);
                color: #04211d;
            }

            .btn:hover { background: var(--accent-strong); }

            .btn-ghost {
                padding: .4rem .8rem;
                background: transparent;
                border-color: var(--border);
                color: var(--text);
                font-size: .85rem;
            }

            .btn-ghost:hover { border-color: var(--accent-strong); color: var(--accent); }

            .alert {
                padding: .8rem 1rem;
                margin-bottom: 1rem;
                border-radius: .6rem;
                border: 1px solid rgba(251, 113, 133, .4);
                background: rgba(251, 113, 133, .12);
                color: var(--danger);
                font-size: .9rem;
            }

            .alert-success {
                border-color: rgba(94, 234, 212, .4);
                background: rgba(94, 234, 212, .1);
                color: var(--accent);
            }

            .alert-info {
                border-color: rgba(99, 102, 241, .4);
                background: rgba(99, 102, 241, .12);
                color: #c7d2fe;
            }

            .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin-top: 1.5rem; }

            .nav { display: flex; gap: .9rem; align-items: center; margin-left: 1rem; }
            .nav a { color: var(--muted); font-size: .9rem; }
            .nav a:hover { color: var(--accent); }

            .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }

            table { width: 100%; border-collapse: collapse; margin-top: 1.25rem; font-size: .9rem; }
            th, td { padding: .7rem .55rem; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
            th { color: var(--muted); font-weight: 600; font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; }
            td form { margin: 0; }
            .inline-form { display: flex; gap: .4rem; align-items: center; }
            .inline-form select { min-width: 8.5rem; padding: .45rem .55rem; font-size: .85rem; }
            .inline-form .btn-ghost { white-space: nowrap; }

            code { color: #bae6fd; font-size: .82rem; word-break: break-all; }
            details summary { cursor: pointer; color: var(--muted); }
            details pre { white-space: pre-wrap; word-break: break-word; font-size: .78rem; color: var(--muted); }
            .pagination { display: flex; gap: .6rem; align-items: center; margin-top: 1.25rem; color: var(--muted); font-size: .9rem; }
            .muted-small { color: var(--muted); font-size: .8rem; }
            .form-panel { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
            .form-panel h2 { margin-bottom: .75rem; }
            .form-panel .btn { width: auto; margin-top: 1rem; }

            .card {
                padding: 1.25rem;
                border: 1px solid var(--border);
                border-radius: .8rem;
                background: rgba(7, 13, 25, .45);
            }

            .card .value { font-size: 1.35rem; font-weight: 700; margin-top: .2rem; }
            .empty { border-style: dashed; }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        {% if app.user %}
            <header class="topbar">
                <a class="brand" href="{{ path('app_dashboard') }}">Auto-Evolving <span>Platform</span></a>
                <div class="topbar-right">
                    {% if tenant is defined and tenant %}
                        <nav class="nav">
                            <a href="{{ path('app_dashboard') }}">Tableau de bord</a>
                            {% if is_granted('TENANT_VIEW', tenant) %}
                                <a href="{{ path('app_tenant_members') }}">Membres</a>
                            {% endif %}
                            {% if is_granted('TENANT_AUDIT', tenant) %}
                                <a href="{{ path('app_audit') }}">Audit</a>
                            {% endif %}
                        </nav>
                        <span class="badge">{{ tenant.name }}</span>
                    {% endif %}
                    <span class="user">{{ app.user.userIdentifier }}</span>
                    <form method="post" action="{{ path('app_logout') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button class="btn-ghost" type="submit">Déconnexion</button>
                    </form>
                </div>
            </header>
        {% endif %}

        <main class="container">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert{% if type == 'success' %} alert-success{% elseif type == 'info' %} alert-info{% endif %}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </body>
</html>
