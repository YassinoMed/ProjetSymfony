{
    "name": "aep/sandbox-runner",
    "description": "Sandbox isolée pour la validation des artefacts générés",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
